# Copy to .env and adjust. Read by Docker Compose and the backend API.
# Never commit .env: it may hold real credentials.

# --- Postgres (docker compose) ---
POSTGRES_USER=clinical
POSTGRES_PASSWORD=clinical
POSTGRES_DB=clinical_notes
# Host port for the database; change it if 5432 is already in use.
POSTGRES_PORT=5432

# --- Backend API ---
# development | test | production
ENVIRONMENT=development
# Must match the Postgres values above.
DATABASE_URL=postgresql+psycopg://clinical:clinical@localhost:5432/clinical_notes
# JSON list of browser origins allowed to call the API.
CORS_ORIGINS=["http://localhost:5173"]
