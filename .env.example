# Copy to .env and adjust. Read by Docker Compose and the backend API.
# Never commit .env: it may hold real credentials.

# --- Postgres (docker compose) ---
POSTGRES_USER=clinical
POSTGRES_PASSWORD=clinical
POSTGRES_DB=clinical_notes
# Host port for the database. 5433 avoids clashing with a locally installed Postgres.
POSTGRES_PORT=5433

# --- Backend API ---
# development | test | production
ENVIRONMENT=development
# Must match the Postgres values above.
DATABASE_URL=postgresql+psycopg://clinical:clinical@localhost:5433/clinical_notes
# JSON list of browser origins allowed to call the API.
CORS_ORIGINS=["http://localhost:5173"]

# --- Authentication ---
# Signs access tokens. Required in production (32+ characters); generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=development-only-secret-do-not-use-in-production
# Access tokens are short-lived; the page renews them with the sign-in cookie.
ACCESS_TOKEN_MINUTES=15
# A sign-in lasts this long however often it is renewed (one shift).
SESSION_HOURS=12
# Failed sign-ins allowed per username, and per address, within the lockout
# window before further attempts are refused until it passes.
LOGIN_FAILURE_LIMIT=5
LOGIN_IP_FAILURE_LIMIT=20
LOGIN_LOCKOUT_MINUTES=15
# Where people open the application; setup links for new users point here.
APP_BASE_URL=http://localhost:5173
# How long a new user's setup link stays valid.
SETUP_LINK_HOURS=72

# --- Real-time ---
# How long the note event log keeps events for clients catching up; remove
# older ones with `uv run clinical-notes-prune-events`.
EVENT_RETENTION_DAYS=30
# The seed gives every user their own random password and lists them in
# credentials.local.md at the repository root (git-ignored).
